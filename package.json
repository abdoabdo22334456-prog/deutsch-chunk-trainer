{
  "name": "chunk-trainer",
  "productName": "دفتر الشانكس",
  "version": "2.1.0",
  "description": "مدرب الشانكس الألمانية — 1500 جملة من A1 إلى C1 بمسار من 6 خطوات وحفظ تلقائي للتقدم",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64 --publish never",
    "build:exe": "electron-builder --win nsis --x64",
    "build:portable": "electron-builder --win portable --x64",
    "setup:whisper": "powershell -ExecutionPolicy Bypass -File scripts/setup-whisper.ps1",
    "parse": "node scripts/parse-chunks.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "preview": "node scripts/preview.mjs",
    "test:ui": "node scripts/visual-test.mjs"
  },
  "author": "Abdo",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.56.0",
    "rcedit": "^5.0.2"
  },
  "dependencies": {
    "snd-lib": "^1.2.4",
    "tone": "^15.1.22"
  },
  "build": {
    "appId": "com.abdo.chunktrainer",
    "productName": "دفتر الشانكس",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "executableName": "ChunkTrainer"
    },
    "nsis": {
      "artifactName": "ChunkTrainer-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "دفتر الشانكس"
    },
    "portable": {
      "artifactName": "ChunkTrainer-Portable-${version}-${arch}.${ext}"
    },
    "files": [
      "src/**/*",
      "data/**/*",
      "assets/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "package.json"
    ]
  }
}
